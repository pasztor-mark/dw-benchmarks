    given-names: Márk
    website: "https://www.pasztormark.dev"
doi: 10.5281/zenodo.24406317
repository-code: "https://github.com/pasztor-mark/dw-benchmarks"
url: "https://dotwire.pasztormark.dev/docs/benchmarks"
keywords:
  - benchmark
  - realtime
  - chat
  - signalr
  - websocket
